# Copy to .env — never commit the real file.
NODE_ENV=development
PORT=4000

# Supabase project settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Used ONLY for email/password sign-in and token refresh
SUPABASE_ANON_KEY=YOUR_ANON_KEY
# SERVER-ONLY. Bypasses RLS. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Exact origin of the frontend (no trailing slash). Used for CORS + CSRF origin check.
FRONTEND_ORIGIN=http://localhost:5173

PHOTO_BUCKET=inspection-photos
MAX_PHOTO_MB=8

# Number of reverse proxies in front of the API (0 = none, 1 = e.g. Render/Heroku/Nginx)
TRUST_PROXY=0
